{
  "name": "meguru-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:fake": "concurrently -k -n fake,api,web -c magenta,blue,green \"pnpm --filter api fake-threads\" \"pnpm --filter api dev:fake\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter '!e2e' test",
    "typecheck": "pnpm -r typecheck",
    "lint": "node --test \"eslint-rules/*.test.js\" && eslint .",
    "e2e": "pnpm --filter e2e test",
    "team:open": "pnpm --filter e2e exec tsx scripts/team-open.ts",
    "worktree:new": "node scripts/worktree.mjs new",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:remove": "node scripts/worktree.mjs remove",
    "worktree:reset-db": "node scripts/worktree.mjs reset-db",
    "team:demo": "docker compose up -d --wait && concurrently -k -s first -n servers,team -c gray,cyan \"pnpm dev:fake\" \"pnpm team:open --setup --wait\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^65.0.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
