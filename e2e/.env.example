# E2E（pnpm e2e）のログインに使う人。e2e/env.ts がこのファイルを読むので、毎回 export しなくてよい。
# Clerk の開発用インスタンスに、一度Googleでログインしたことのあるアカウントを書く。
# このファイルを e2e/.env.local にコピーして書き換える（.env.local はコミットしない）。

# ふだんのテスト（チーム以外）でログインする人
E2E_CLERK_USER_EMAIL=e2e@example.com

# チームのE2E（pnpm e2e -- team）と、3人の画面をまとめて開くスクリプト（pnpm team:open）で使う。
# Clerk の開発用インスタンスに、一度Googleでログインしたことのあるアカウントを3つ書く。
# E2E_PARTNER_EMAIL は、チームを作る管理者の人（名前は008のまま）。
E2E_OWNER_EMAIL=owner@example.com
E2E_PARTNER_EMAIL=partner@example.com
E2E_EDITOR_EMAIL=editor@example.com
