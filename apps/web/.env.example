# apps/web のローカル開発用の環境変数。コピーして .env.local を作る（コミットしない）
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# APIのベースURL（ローカルの wrangler dev）
VITE_API_BASE_URL=http://localhost:8787
# どの環境か（specs/015-deploy-environments）。production / staging / development の3つだけ
# production 以外では、画面のいちばん上に環境の帯が出る
VITE_APP_ENV=development
