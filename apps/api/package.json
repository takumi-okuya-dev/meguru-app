{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:fake": "wrangler dev --port 8787 --var THREADS_AUTH_BASE_URL:http://localhost:8790 --var THREADS_GRAPH_BASE_URL:http://localhost:8790 --var THREADS_REDIRECT_URI:http://localhost:8787/api/threads/callback",
    "fake-threads": "tsx test/fake-threads/serve.ts",
    "fake-stripe": "tsx test/fake-stripe/serve.ts",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:psql": "docker compose exec -T postgres psql -U postgres -d threads_grower",
    "admin:set-billing-exempt": "tsx scripts/set-billing-exempt.ts",
    "admin:rotate-token-key": "tsx scripts/rotate-token-key.ts",
    "seed:performance": "tsx scripts/seed-performance.ts",
    "routes:snapshot": "tsx scripts/dump-routes.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@neondatabase/serverless": "^1.2.0",
    "@meguru/shared": "workspace:^",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@hono/node-server": "^2.1.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.146.0",
    "ws": "^8.22.0"
  }
}
